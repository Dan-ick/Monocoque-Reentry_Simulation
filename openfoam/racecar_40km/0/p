FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 277.5;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 277.5;
    }
    
    outlet
    {
        type            zeroGradient;
    }

    farfield
        {
                type            zeroGradient;
        }

    symmetry
        {
                type            symmetryPlane;
        }

    rennwagenGroup
        {
                type            zeroGradient;
        }

}


